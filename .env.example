# ============================================================
# PBAgent 环境变量模板
#
# 用法：复制为 .env 后填入真实值
#   cp .env.example .env
#
# .env 已在 .gitignore 中，不会被提交——请勿把真实密钥写进本文件
# ============================================================

# ---------- LLM 配置（STATE B 兜底必需，三项全部必填）----------
# 任何 OpenAI 兼容接口均可，后端会请求 <BASE_URL>/chat/completions

# 接口地址（结尾不要带 /v1 之外的路径，也不要带尾斜杠）
PBA_LLM_BASE_URL=https://api.deepseek.com

# API 密钥
PBA_LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 模型名
PBA_LLM_MODEL=deepseek-flash

# ⚠️ 选模型前必读：Agent 模式每一轮都会把页面截图一起发给模型，
#    所以【模型必须支持图像输入（vision）】，否则 STATE B 直接不可用。
#    实测记录：
#      ✅ deepseek-flash  支持视觉，约 1s 响应（当前默认，已配好单价）
#      ❌ deepseek-v4-pro 官方标注不支持图像输入
#      ❌ mimo-v2.5-pro   纯文本 200，带图请求直接 404
#    换模型后务必实测「纯文本 + 带截图」两项，/api/health 通过不代表支持视觉。

# ---------- 凭证加密密钥（可选）----------
# Playbook 里的登录凭证以 AES-256-GCM 加密存于 credentials/
# 不设置时会在 ~/.pbagent/.key 自动生成本地密钥文件（个人开发够用）
# CI / 服务器部署建议显式设置，否则换机器后已存凭证解不开
# PBAGENT_KEY=换成一个足够长的随机字符串

# ---------- 演示站点登录密码（可选）----------
# 仅用于本地 test-site（端口 3456）与自带 demo playbook 的
# ${env.DEMO_PASSWORD} 占位符；跑自己的 Playbook 不需要
DEMO_PASSWORD=demo123
